# ── Where registrations are stored ────────────────────────────────────────────
# file      Local development only. Vercel's filesystem is read-only and
#           per-invocation, so this loses every registration in production.
# airtable  A normal Airtable base Christy can open, read and export herself.
STORE=file

# Needed when STORE=airtable. Create a token at airtable.com/create/tokens with
# data.records:read and data.records:write scopes on the base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Registrations

# ── Payments ──────────────────────────────────────────────────────────────────
# OFF by default. While false the site collects registrations and charges
# nothing; Christy is handed the details and arranges payment herself.
# Only set true once her Stripe account is live and verified.
PAYMENTS_ENABLED=false

# Needed only when PAYMENTS_ENABLED=true.
# Test keys:  stripe sandbox create --email you@example.com
# Prefer a restricted key (rk_...) over a secret key (sk_...).
STRIPE_SECRET_KEY=
# Printed by:  stripe listen --forward-to http://localhost:4242/api/webhook
STRIPE_WEBHOOK_SECRET=

PORT=4242
# Leave blank on Vercel — the request host is used automatically.
PUBLIC_ORIGIN=http://localhost:4242
