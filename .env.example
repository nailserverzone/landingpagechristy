# ── Where registrations are stored ────────────────────────────────────────────
# file      Local development only. Vercel's filesystem is read-only and
#           per-invocation, so this loses every registration in production.
# airtable  A normal Airtable base Christy can open, read and export herself.
STORE=file

# Needed when STORE=airtable. Create a token at airtable.com/create/tokens with
# data.records:read and data.records:write scopes on the base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Registrations

# ── Payments ──────────────────────────────────────────────────────────────────
# There are three modes. The first one that applies wins.
#
# 1. STRIPE_PAYMENT_LINK set  — redirect to a Payment Link Christy made in her
#    own dashboard. No API key, no webhook, no access to her account. Nothing
#    reports back, so rows stay `awaiting_payment` until she ticks them off.
#    Must be an https://buy.stripe.com/... URL; anything else is ignored.
STRIPE_PAYMENT_LINK=

# 2. PAYMENTS_ENABLED=true + the two keys below — full Stripe Checkout. Prices
#    are set server-side, the webhook marks rows confirmed on its own, and the
#    card is saved so the balance can be charged later.
# 3. Neither — collect registrations, charge nothing, Christy follows up.
PAYMENTS_ENABLED=false

# Needed only when PAYMENTS_ENABLED=true.
# Test keys:  stripe sandbox create --email you@example.com
# Prefer a restricted key (rk_...) over a secret key (sk_...).
STRIPE_SECRET_KEY=
# Printed by:  stripe listen --forward-to http://localhost:4242/api/webhook
STRIPE_WEBHOOK_SECRET=

PORT=4242
# Leave blank on Vercel — the request host is used automatically.
PUBLIC_ORIGIN=http://localhost:4242
