# ── Payments ──────────────────────────────────────────────────────────────────
# OFF by default. While false the site collects registrations and charges
# nothing; Christy is handed the details and arranges payment herself.
# Only set this to true once her Stripe account is live and verified.
PAYMENTS_ENABLED=false

# Needed only when PAYMENTS_ENABLED=true.
# Test keys:  stripe sandbox create --email you@example.com
# Prefer a restricted key (rk_...) over a secret key (sk_...).
STRIPE_SECRET_KEY=
# Printed by:  stripe listen --forward-to http://localhost:4242/api/webhook
STRIPE_WEBHOOK_SECRET=

PORT=4242
PUBLIC_ORIGIN=http://localhost:4242
