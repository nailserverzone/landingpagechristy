# Copy to .env for local development. On Netlify, set these under
# Site configuration > Environment variables. Variables starting with PUBLIC_
# end up in the browser, so never put a secret in one.

# --- Contact details shown on the site -------------------------------------
# Shown in the footer and the press kit. TODO(content): client to confirm.
PUBLIC_BOOKING_EMAIL=
PUBLIC_FAN_EMAIL=

# --- Form destinations (Netlify Forms) --------------------------------------
# Netlify Forms emails submissions through "Form notifications" in the Netlify
# UI, not through code. These two values are documentation for whoever sets
# those notifications up: booking-inquiry -> BOOKING_EMAIL, fan-message -> FAN_EMAIL.
BOOKING_EMAIL=
FAN_EMAIL=

# Optional: post forms somewhere other than Netlify (for example Formspree).
# Leave blank to use Netlify Forms.
PUBLIC_BOOKING_FORM_ENDPOINT=
PUBLIC_FAN_FORM_ENDPOINT=

# --- Fan email list ---------------------------------------------------------
# kit | mailchimp | netlify (netlify just stores signups as a Netlify form)
PUBLIC_EMAIL_PROVIDER=netlify
# The provider's public form action URL (Kit form URL or Mailchimp list URL).
PUBLIC_EMAIL_FORM_ACTION=

# --- Analytics --------------------------------------------------------------
# plausible | ga4 | none
PUBLIC_ANALYTICS_PROVIDER=plausible
PUBLIC_PLAUSIBLE_DOMAIN=gagemarvel.com
PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.tagged-events.outbound-links.js
PUBLIC_GA4_ID=

# --- Feature flags ----------------------------------------------------------
SHOW_MERCH=false
ENABLE_CMS=false
ENABLE_BANDSINTOWN=false
PUBLIC_BANDSINTOWN_ARTIST=

# Show entries marked `sample: true` (demo shows). On for local dev and deploy
# previews, off for production.
SHOW_SAMPLE_CONTENT=
