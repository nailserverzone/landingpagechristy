---
/**
 * Merch, only built when SHOW_MERCH=true (see astro.config.mjs).
 * Products come from src/content/merch. Each one shows, in order of
 * preference: a Shopify Buy Button (if PUBLIC_SHOPIFY_* and the product's
 * shopifyProductId are set), a link to its store page, or "Coming soon".
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FanSignup from '@/components/ui/FanSignup.astro';
import Scribble from '@/components/ui/Scribble.astro';
import { getMerch } from '@/lib/content';

const products = await getMerch();
const env = import.meta.env;
const storeUrl = env.PUBLIC_STORE_URL || '';
const shopify =
  env.PUBLIC_SHOPIFY_DOMAIN && env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN
    ? { domain: env.PUBLIC_SHOPIFY_DOMAIN, token: env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN }
    : null;
---

<BaseLayout title="Merch" description="Official Gage Marvel merch: shirts, patches and more.">
  <header class="container-site pt-12 pb-10 lg:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-charcoal-2 pb-8">
      <h1 class="page-title">Merch</h1>
      <div class="max-w-sm">
        <p class="text-ivory-muted">
          The same table you'd find at the back of the room after the show.
        </p>
        {storeUrl && (
          <a href={storeUrl} target="_blank" rel="noopener" class="btn btn-gold mt-5">
            Visit the store<span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
      </div>
    </div>
  </header>

  {products.length > 0 ? (
    <section class="container-site pb-24" aria-label="Products">
      <Scribble text="grab one at the show too" arrow="down" class="mb-2 ml-2" />
      <ul class="table-grid">
        {products.map((p, i) => {
          const d = p.data;
          return (
            <li class="item" data-reveal>
              <div class="photo" data-tilt>
                <Image
                  src={d.image}
                  alt={d.alt}
                  widths={[400, 640, 900]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                  format="webp"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  class="size-full object-cover"
                />
                {d.soldOut && (
                  <span class="stamp marker" aria-hidden="true">
                    Sold out
                  </span>
                )}
                {d.sample && (
                  <span class="label sample" aria-hidden="true">
                    Sample
                  </span>
                )}
              </div>

              <span class="tag" aria-hidden="true">
                <span class="hole" />
                <span class="font-display price">{d.price ?? 'Price TBA'}</span>
              </span>

              <h2 class="mt-5 text-3xl">{d.name}</h2>
              <p class="sr-only">Price: {d.price ?? 'to be announced'}</p>
              {d.soldOut && <p class="mt-1 text-ivory-muted">Sold out</p>}

              <div class="mt-4">
                {d.soldOut ? null : shopify && d.shopifyProductId ? (
                  <div class="buy" data-shopify-id={d.shopifyProductId}>
                    <p class="text-sm text-ivory-muted">Loading checkout...</p>
                  </div>
                ) : d.url ? (
                  <a href={d.url} target="_blank" rel="noopener" class="btn btn-gold btn-sm">
                    Shop {d.name}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <span class="label text-ivory-muted">Coming soon</span>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ) : (
    <section class="container-site pb-24">
      <div class="empty grid gap-10 lg:grid-cols-2">
        <div>
          <p class="font-display text-display-sm uppercase">Merch is on the way.</p>
          <p class="mt-3 max-w-md text-ivory-muted">
            Join the fan list and you'll know the minute the table is set up.
          </p>
        </div>
        <FanSignup id="merch-signup" variant="compact" location="merch_empty" />
      </div>
    </section>
  )}
</BaseLayout>

{shopify && <script is:inline define:vars={{ shopify }}>
  // Load the Shopify Buy Button only when a product with an ID is on screen.
  const nodes = [...document.querySelectorAll('[data-shopify-id]')];
  if (nodes.length) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const s = document.createElement('script');
      s.src = 'https://sdks.shopifycdn.com/buy-button/latest/buy-button-storefront.min.js';
      s.async = true;
      s.onload = () => {
        const client = window.ShopifyBuy.buildClient({
          domain: shopify.domain,
          storefrontAccessToken: shopify.token,
        });
        window.ShopifyBuy.UI.onReady(client).then((ui) => {
          nodes.forEach((node) => {
            node.innerHTML = '';
            ui.createComponent('product', {
              id: node.dataset.shopifyId,
              node,
              options: {
                product: {
                  contents: { img: false, title: false, price: false, options: true },
                  text: { button: 'Add to cart' },
                  styles: {
                    button: {
                      'background-color': '#E8B830',
                      color: '#0B0B0B',
                      'font-weight': '700',
                      'letter-spacing': '0.14em',
                      'text-transform': 'uppercase',
                      ':hover': { 'background-color': '#C99A1C' },
                    },
                  },
                },
                cart: { styles: { button: { 'background-color': '#E8B830', color: '#0B0B0B' } } },
                toggle: { styles: { toggle: { 'background-color': '#E8B830', color: '#0B0B0B' } } },
              },
            });
          });
        });
      };
      document.head.appendChild(s);
    });
    nodes.forEach((n) => io.observe(n));
  }
</script>}

<style>
  .page-title {
    font-size: clamp(4.5rem, 18vw, 15rem);
    line-height: 0.8;
    font-weight: 900;
  }
  .table-grid {
    display: grid;
    gap: 3.5rem 2rem;
  }
  @media (min-width: 40rem) {
    .table-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .table-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .item {
    position: relative;
  }
  .photo {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: var(--charcoal);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 400ms var(--ease-out-soft);
    will-change: transform;
  }
  /* Swing tag hanging off the corner. */
  .tag {
    position: absolute;
    top: 1rem;
    right: -0.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1rem 0.55rem 0.8rem;
    background: var(--gold);
    color: var(--black);
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 14px 100%, 0 50%);
    transform: rotate(6deg);
    transform-origin: left center;
    box-shadow: 0 6px 14px -6px rgb(0 0 0 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .item:hover .tag {
      animation: swing 1.1s var(--ease-out-soft);
    }
  }
  @keyframes swing {
    30% {
      transform: rotate(-4deg);
    }
    60% {
      transform: rotate(9deg);
    }
  }
  .hole {
    width: 8px;
    height: 8px;
    margin-left: 6px;
    border-radius: 50%;
    background: var(--black);
  }
  .price {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }
  .stamp {
    position: absolute;
    left: 50%;
    top: 50%;
    padding: 0.2rem 1rem;
    border: 4px solid #d9472f;
    color: #ff8b73;
    font-size: 2.25rem;
    transform: translate(-50%, -50%) rotate(-14deg);
    background: rgb(11 11 11 / 0.55);
  }
  .sample {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: var(--black);
    font-size: 0.6875rem;
  }
  .empty {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--charcoal-2);
    background: var(--charcoal);
  }
</style>

<script>
  // A gentle 3D tilt toward the pointer, like picking a shirt off the table.
  if (
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    matchMedia('(pointer: fine)').matches
  ) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.setProperty('--ry', `${x * 10}deg`);
        el.style.setProperty('--rx', `${-y * 10}deg`);
      });
      el.addEventListener('pointerleave', () => {
        el.style.setProperty('--ry', '0deg');
        el.style.setProperty('--rx', '0deg');
      });
    });
  }
</script>
