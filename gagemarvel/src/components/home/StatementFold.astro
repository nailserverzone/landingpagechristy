---
/**
 * Statement fold: a short line about the music, an outlined index numeral
 * (the real number of releases), the featured single with its preview and
 * player, and a big record drifting off the right edge. The record turns
 * with scroll, and really spins while its preview is playing.
 */
import { Image } from 'astro:assets';
import PreviewButton from '@/components/music/PreviewButton.astro';
import PlatformButtons from '@/components/music/PlatformButtons.astro';
import PlayerEmbed from '@/components/music/PlayerEmbed.astro';
import ShareButton from '@/components/music/ShareButton.astro';
import { getSongs, getFeaturedSong } from '@/lib/content';
import { formatDate, kindLabel, releaseYear } from '@/lib/music';

const songs = await getSongs();
const featured = (await getFeaturedSong())!;
const years = songs.map(releaseYear).filter(Boolean).sort();
const count = String(songs.length).padStart(2, '0');
---

<section id="statement" class="fold relative isolate overflow-hidden" aria-labelledby="fold-title">
  <div class="disc-wrap" aria-hidden="true" data-fold-disc>
    <div class="disc" data-spin-for={featured.id}>
      <Image
        src={featured.data.cover}
        alt=""
        widths={[320, 480, 640]}
        sizes="40vw"
        format="webp"
        class="disc-label"
      />
    </div>
  </div>

  <div class="container-site grid min-h-[100svh] content-center gap-14 py-24 lg:grid-cols-12">
    <div class="lg:col-span-8" data-reveal>
      <p class="label flex items-center gap-3 text-ivory-muted">
        <span class="gold-rule w-8!"></span>
        {count} records · {years[0]} to {years[years.length - 1]} · Marvel Records
      </p>
      <!-- TODO(content): client to approve or rewrite this line. It is drawn
           only from the song titles; it makes no claims about Gage's life. -->
      <p class="statement mt-8">
        Songs about <em>faith, family</em>, an ice cold beer and the ones who stand beside you.
      </p>
      <span class="index font-display" aria-hidden="true">
        {count}
      </span>
    </div>

    <div class="feature lg:col-span-7" data-reveal>
      <p class="label flex items-center gap-3 text-gold">
        <span class="eq" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        Featured {kindLabel(featured).toLowerCase()}
      </p>
      <h2 id="fold-title" class="text-display-md mt-3">
        {featured.data.title}
      </h2>
      <p class="mt-2 text-ivory-muted">
        {featured.data.releaseDate && <>Released {formatDate(featured.data.releaseDate)} · </>}
        {featured.data.label}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <PreviewButton song={featured} variant="gold" location="home_featured" />
        <button type="button" class="btn btn-outline btn-sm" data-listen-open>
          Listen Now
        </button>
        <ShareButton title={featured.data.title} path={`/music#${featured.id}`} />
      </div>
      <PlayerEmbed song={featured} class="mt-6 max-w-xl" />
      <p class="label mt-6 text-ivory-muted">Also on</p>
      <PlatformButtons song={featured} location="home_featured" class="mt-3" />
    </div>
  </div>
</section>

<style>
  .fold {
    background: var(--black);
  }
  .statement {
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 5.25rem);
    line-height: 0.92;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .statement em {
    font-style: normal;
    color: var(--gold);
  }
  .index {
    display: block;
    margin-top: 1rem;
    font-size: clamp(7rem, 18vw, 16rem);
    font-weight: 900;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(244 238 223 / 0.35);
  }
  .feature {
    padding-top: 2rem;
    border-top: 1px solid var(--charcoal-2);
  }

  /* The drifting record, mostly off the right edge. */
  .disc-wrap {
    position: absolute;
    top: 12%;
    right: calc(-1 * min(26vw, 22rem));
    z-index: -1;
    width: min(62vw, 46rem);
    aspect-ratio: 1;
    opacity: 0.55;
    will-change: transform;
  }
  @media (max-width: 63.99rem) {
    .disc-wrap {
      top: 4%;
      opacity: 0.28;
    }
  }
  .disc {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      conic-gradient(
        from 20deg,
        transparent 0 10%,
        rgb(255 255 255 / 0.08) 14%,
        transparent 20% 55%,
        rgb(255 255 255 / 0.06) 62%,
        transparent 70%
      ),
      repeating-radial-gradient(circle closest-side, #111 0 0.7%, #1b1b1b 0.8% 1.4%);
    box-shadow: 0 0 0 1px #000;
  }
  .disc :global(.disc-label) {
    position: absolute;
    inset: 32%;
    width: 36%;
    height: 36%;
    border-radius: 50%;
    object-fit: cover;
  }
  .disc::after {
    content: '';
    position: absolute;
    inset: 49%;
    border-radius: 50%;
    background: var(--black);
  }
  @media (prefers-reduced-motion: no-preference) {
    .disc {
      animation: spin 1.8s linear infinite;
      animation-play-state: paused;
    }
    .disc:global(.is-spinning) {
      animation-play-state: running;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    background: currentColor;
    transform-origin: bottom;
  }
  .eq i:nth-child(2) {
    transform: scaleY(0.55);
  }
  .eq i:nth-child(3) {
    transform: scaleY(0.8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .eq i {
      animation: eq 1.1s ease-in-out infinite alternate;
    }
    .eq i:nth-child(2) {
      animation-delay: -0.4s;
    }
    .eq i:nth-child(3) {
      animation-delay: -0.75s;
    }
  }
  @keyframes eq {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>

<script>
  import { scroll } from 'motion';
  const wrap = document.querySelector<HTMLElement>('[data-fold-disc]');
  const section = wrap?.closest('section');
  if (wrap && section && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    scroll(
      (p: number) => {
        // Drift up and turn as the fold passes through the viewport.
        wrap.style.transform = `translate3d(${-p * 6}vw, ${(0.5 - p) * 18}vh, 0) rotate(${p * 220}deg)`;
      },
      { target: section, offset: ['start end', 'end start'] },
    );
  }
</script>
