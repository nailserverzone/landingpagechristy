---
/**
 * The portal. The hero begins closed: two record-sleeve panels (Side A and
 * Side B, listing the real releases) meet in the middle under the wordmark.
 * Scrolling parts them to uncover the latest cover full-bleed, while GAGE and
 * MARVEL grow, tighten and travel to opposite edges.
 *
 * Every value is bound to scroll POSITION, so it plays backwards on the way
 * up. With reduced motion (or no JavaScript) the hero renders already open,
 * one screen tall: the finished state.
 */
import { getImage } from 'astro:assets';
import PreviewButton from '@/components/music/PreviewButton.astro';
import { getSongs, getFeaturedSong } from '@/lib/content';
import { formatDate } from '@/lib/music';
import { site, social, activeLinks, withUtm } from '@/config/site';

const featured = (await getFeaturedSong())!;
const songs = await getSongs();
const sideA = songs.slice(0, Math.ceil(songs.length / 2));
const sideB = songs.slice(Math.ceil(songs.length / 2));
// TODO(content): swap for the professional hero photo once it arrives.
const bg = await getImage({
  src: featured.data.cover,
  widths: [480, 800, 1200, 1600],
  format: 'webp',
});
const followUrl = activeLinks(social)[0]?.[1] ?? '';
---

<section class="portal" data-portal aria-labelledby="portal-title">
  <div class="stage">
    <img
      class="p-img"
      src={bg.src}
      srcset={bg.srcSet.attribute}
      sizes="100vw"
      alt=""
      fetchpriority="high"
      data-p="img"
    />
    <div class="p-duo" data-p="duo" aria-hidden="true"></div>
    <div class="p-veil" aria-hidden="true"></div>

    <div class="p-panel p-left" data-p="left" aria-hidden="true">
      <div class="side">
        <p class="label text-gold">Side A</p>
        <ol>
          {sideA.map((s, i) => (
            <li>
              <span class="n">A{i + 1}</span>
              {s.data.title}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="p-panel p-right" data-p="right" aria-hidden="true">
      <div class="side side-r">
        <p class="label text-gold">Side B</p>
        <ol>
          {sideB.map((s, i) => (
            <li>
              <span class="n">B{i + 1}</span>
              {s.data.title}
            </li>
          ))}
        </ol>
      </div>
    </div>

    <span class="p-dot" data-p="dot1" aria-hidden="true"></span>
    <span class="p-dot" data-p="dot2" aria-hidden="true"></span>

    <h1 id="portal-title" class="p-title" data-p="title">
      <span class="half" data-p="h1">
        Gage
      </span>
      <span class="sp"> </span>
      <span class="half" data-p="h2">
        Marvel
      </span>
    </h1>

    <div class="p-meta p-top label" aria-hidden="true">
      <span>Country music</span>
      <span>{site.label}</span>
    </div>

    <div class="p-meta p-bottom">
      <a href="#statement" class="latest">
        <span class="label text-gold">Latest release</span>
        <span class="font-display t">{featured.data.title}</span>
        {featured.data.releaseDate && (
          <span class="label text-ivory-muted">{formatDate(featured.data.releaseDate)}</span>
        )}
      </a>
      <div class="p-cta" data-p="cta">
        <button type="button" class="btn btn-gold" data-listen-open>
          Listen Now
        </button>
        <PreviewButton song={featured} variant="pill" location="hero" />
        {followUrl && (
          <a
            href={withUtm(followUrl, 'hero')}
            target="_blank"
            rel="noopener"
            class="btn btn-outline"
            data-follow="instagram"
            data-location="hero"
          >
            Follow Gage<span class="sr-only"> (opens in a new tab)</span>
          </a>
        )}
      </div>
    </div>

    <p class="p-hint label" data-p="hint" aria-hidden="true">
      Scroll to open
    </p>
  </div>
</section>

<style>
  /* ---------- finished (static) state: reduced motion and no-JS ---------- */
  .portal {
    position: relative;
    height: 100svh;
    min-height: 36rem;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
    isolation: isolate;
    background: var(--black);
  }
  .p-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
  }
  .p-duo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(120deg, var(--gold), #b8481c);
    mix-blend-mode: overlay;
    opacity: 0.3;
  }
  .p-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 90% at 50% 45%, transparent 30%, rgb(11 11 11 / 0.85) 100%),
      linear-gradient(to top, rgb(11 11 11 / 0.92), transparent 45%);
  }
  .p-panel,
  .p-dot,
  .p-hint {
    display: none;
  }
  .p-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 46%;
    display: flex;
    justify-content: center;
    font-size: clamp(3.5rem, 14vw, 15rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: 0;
    white-space: nowrap;
    transform: translateY(-50%);
    color: var(--ivory);
    pointer-events: none;
  }
  .p-title .sp {
    width: 0.32em;
  }
  .half {
    display: inline-block;
    will-change: transform;
  }
  .p-meta {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }
  .p-top {
    top: calc(var(--header-h) + 1rem);
    color: rgb(244 238 223 / 0.75);
  }
  .p-bottom {
    bottom: 0;
    padding-bottom: clamp(1.25rem, 4vh, 2.5rem);
    align-items: flex-end;
    flex-wrap: wrap;
  }
  .latest {
    display: grid;
    gap: 0.25rem;
  }
  .latest .t {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .latest:hover .t {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .p-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* ---------- live portal: only when JS confirmed motion is OK ---------- */
  :global(.portal-live) .portal {
    height: 260vh;
  }
  :global(.portal-live) .p-panel {
    display: flex;
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50.5%;
    z-index: 1;
    background: radial-gradient(140% 80% at 50% 50%, #1d1d1d, #111 70%), var(--charcoal);
    will-change: transform;
  }
  /* The stage spotlight: a soft hole in the panels that shows the cover
     underneath, following the cursor (or drifting on its own on touch). */
  :global(.portal-live) .p-panel {
    --sr: 0px;
    -webkit-mask: radial-gradient(
      circle var(--sr) at var(--sx, 50%) var(--sy, 50%),
      transparent 0 45%,
      #000 100%
    );
    mask: radial-gradient(
      circle var(--sr) at var(--sx, 50%) var(--sy, 50%),
      transparent 0 45%,
      #000 100%
    );
  }
  :global(.portal-live) .p-left {
    left: 0;
    justify-content: flex-start;
    align-items: flex-end;
    border-right: 1px solid rgb(232 184 48 / 0.55);
  }
  :global(.portal-live) .p-right {
    right: 0;
    justify-content: flex-end;
    align-items: flex-end;
  }
  .side {
    padding: 0 clamp(1rem, 4vw, 2.5rem) clamp(7rem, 16vh, 9rem);
    max-width: 22rem;
  }
  .side-r {
    text-align: right;
  }
  .side ol {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.35rem;
    font-size: 0.9rem;
    color: rgb(244 238 223 / 0.65);
  }
  .side .n {
    display: inline-block;
    width: 2rem;
    color: var(--ivory-muted);
    font-variant-numeric: tabular-nums;
  }
  .side-r .n {
    width: auto;
    margin-right: 0.5rem;
  }
  @media (max-width: 40rem) {
    .side ol {
      display: none;
    }
  }
  :global(.portal-live) .p-dot {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px rgb(232 184 48 / 0.18);
    will-change: transform;
  }
  :global(.portal-live) .p-title {
    z-index: 3;
    /* Same as render(0), so the script's first frame changes nothing. */
    transform: translateY(-50%) scale(0.78);
    letter-spacing: 0.16em;
  }
  :global(.portal-live) .p-cta {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    pointer-events: none;
  }
  :global(.portal-live) .p-img {
    transform: scale(1.22);
  }
  :global(.portal-live) .p-duo {
    opacity: 0;
  }
  :global(.portal-live) .p-meta {
    z-index: 3;
  }
  :global(.portal-live) .p-hint {
    display: block;
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    z-index: 3;
    transform: translateX(-50%);
    color: var(--ivory-muted);
  }
  @media (max-width: 47.99rem) {
    :global(.portal-live) .p-hint {
      display: none;
    }
  }
</style>

<script>
  import { scroll } from 'motion';

  const section = document.querySelector<HTMLElement>('[data-portal]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // .portal-live is set in <head> (BaseLayout) so the first paint is already
  // the closed state and nothing jumps when this script runs.
  if (section && !reduce) {
    const q = (k: string) => section.querySelector<HTMLElement>(`[data-p="${k}"]`)!;
    const img = q('img');
    const duo = q('duo');
    const left = q('left');
    const right = q('right');
    const dot1 = q('dot1');
    const dot2 = q('dot2');
    const title = q('title');
    const h1 = q('h1');
    const h2 = q('h2');
    const cta = q('cta');
    const hint = q('hint');

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    // Map p within [a, b] to 0..1 with a smooth ease-in-out.
    const seg = (p: number, a: number, b: number) => {
      const t = clamp((p - a) / (b - a));
      return t * t * (3 - 2 * t);
    };

    const render = (p: number) => {
      const open = seg(p, 0.04, 0.62); // panels
      const grow = seg(p, 0.0, 0.75); // title
      const w = window.innerWidth;
      const h = window.innerHeight;

      left.style.transform = `translate3d(${-open * 104}%,0,0)`;
      right.style.transform = `translate3d(${open * 104}%,0,0)`;
      img.style.transform = `scale(${1.22 - 0.22 * open})`;
      duo.style.opacity = String(open * 0.32);

      // Dots ride out toward opposite corners.
      dot1.style.transform = `translate3d(${-open * w * 0.42}px,${-open * h * 0.36}px,0)`;
      dot2.style.transform = `translate3d(${open * w * 0.42}px,${open * h * 0.3}px,0)`;
      const dotsOut = String(1 - seg(p, 0.6, 0.8));
      dot1.style.opacity = dotsOut;
      dot2.style.opacity = dotsOut;

      // The title grows WHILE its tracking tightens, and its halves part.
      const scale = 0.78 + 0.22 * grow;
      title.style.transform = `translateY(-50%) scale(${scale})`;
      title.style.letterSpacing = `${0.16 - 0.17 * grow}em`;
      // Slide each half out to the page margin, measured so it never runs
      // off-screen on any width.
      const pad = Math.max(16, Math.min(w * 0.04, 40));
      const sp = title.querySelector<HTMLElement>('.sp')!;
      const textW = (h1.offsetWidth + sp.offsetWidth + h2.offsetWidth) * scale;
      const free = Math.max(0, (w - 2 * pad - textW) / 2) / scale;
      h1.style.transform = `translate3d(${-free * grow}px,0,0)`;
      h2.style.transform = `translate3d(${free * grow}px,0,0)`;

      const c = seg(p, 0.55, 0.8);
      cta.style.opacity = String(c);
      cta.style.transform = `translate3d(0,${(1 - c) * 24}px,0)`;
      cta.style.pointerEvents = c > 0.5 ? 'auto' : 'none';
      hint.style.opacity = String(1 - seg(p, 0, 0.12));
    };

    render(0);

    // ---- stage spotlight ----
    let sx = window.innerWidth * 0.62;
    let sy = window.innerHeight * 0.42;
    let radius = 0;
    let wantR = 0;
    let pointer = false;
    let progress = 0;
    const stage = section.querySelector<HTMLElement>('.stage')!;
    const applySpot = () => {
      for (const panel of [left, right]) {
        const r = panel.getBoundingClientRect();
        panel.style.setProperty('--sx', `${sx - r.left}px`);
        panel.style.setProperty('--sy', `${sy - r.top}px`);
        panel.style.setProperty('--sr', `${radius}px`);
      }
    };
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      pointer = true;
      sx = e.clientX;
      sy = e.clientY;
      wantR = Math.min(window.innerWidth, 900) * 0.2;
    });
    stage.addEventListener('pointerleave', () => {
      pointer = false;
      wantR = 0;
    });
    const coarse = matchMedia('(pointer: coarse)').matches;
    let t0 = 0;
    let onScreen = true;
    new IntersectionObserver(([e]) => (onScreen = e.isIntersecting)).observe(stage);
    const spot = (ts: number) => {
      requestAnimationFrame(spot);
      if (!onScreen) return;
      // On touch screens the light drifts by itself while the hero is closed.
      if (coarse && !pointer) {
        t0 = ts / 1000;
        sx = window.innerWidth * (0.5 + 0.28 * Math.sin(t0 * 0.6));
        sy = window.innerHeight * (0.45 + 0.12 * Math.sin(t0 * 0.9 + 1));
        wantR = progress < 0.3 ? window.innerWidth * 0.32 : 0;
      }
      radius += (wantR - radius) * 0.12;
      applySpot();
    };
    requestAnimationFrame(spot);
    // Keyboard users tabbing into the buttons before the portal has opened:
    // jump to the open state so they can see what's focused.
    cta.addEventListener('focusin', () => {
      const end = section.offsetTop + section.offsetHeight - window.innerHeight;
      if (window.scrollY < end * 0.85) window.scrollTo({ top: end, behavior: 'instant' });
    });
    scroll(
      (p: number) => {
        progress = p;
        render(p);
      },
      {
        target: section,
        offset: ['start start', 'end end'],
      },
    );
  }
</script>
