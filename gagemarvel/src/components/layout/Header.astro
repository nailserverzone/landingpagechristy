---
import Wordmark from '@/components/brand/Wordmark.astro';
import Icon from '@/components/icons/Icon.astro';
import PlatformIcon from '@/components/icons/PlatformIcon.astro';
import { nav, bookingHref, social, socialLabels, activeLinks, withUtm } from '@/config/site';

interface Props {
  /** Start transparent over a hero image; turns solid once scrolled. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const socials = activeLinks(social);
---

<header
  class="site-header fixed inset-x-0 top-0 z-50"
  data-header
  data-solid={overlay ? 'false' : 'true'}
>
  <div class="container-site flex h-[var(--header-h)] items-center justify-between gap-6">
    <a href="/" class="-m-2 shrink-0 p-2" aria-label="Gage Marvel, home">
      <Wordmark title="" class="h-11 w-auto" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 xl:gap-3">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link label', isActive(item.href) && 'is-active']}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={bookingHref} class="btn btn-gold btn-sm">
        Book Gage
      </a>
      <button
        type="button"
        class="menu-toggle inline-flex size-12 items-center justify-center lg:hidden"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <Icon name="menu" size={26} />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: a native modal dialog gives us focus trapping, Esc to close
     and an inert page behind it without extra code. -->
<dialog id="mobile-menu" class="mobile-menu" aria-label="Menu" data-menu>
  <div class="flex min-h-full flex-col">
    <div class="container-site flex h-[var(--header-h)] items-center justify-between">
      <a href="/" class="-m-2 p-2" aria-label="Gage Marvel, home">
        <Wordmark title="" class="h-11 w-auto" />
      </a>
      <button
        type="button"
        class="inline-flex size-12 items-center justify-center"
        data-menu-close
        autofocus
      >
        <Icon name="close" size={26} />
        <span class="sr-only">Close menu</span>
      </button>
    </div>
    <nav aria-label="Main" class="container-site flex-1 pt-6">
      <ul class="flex flex-col">
        {nav.map((item, i) => (
          <li style={`--i:${i}`} class="mobile-item">
            <a
              href={item.href}
              class:list={[
                'font-display block border-b border-charcoal-2 py-4 text-[2.75rem] leading-none font-extrabold uppercase',
                isActive(item.href) ? 'text-gold' : 'text-ivory',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={bookingHref} class="btn btn-gold mt-8 w-full">
        Book Gage
      </a>
    </nav>
    {socials.length > 0 && (
      <div class="container-site pt-8 pb-10">
        <p class="label text-ivory-muted">Follow Gage</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {socials.map(([key, url]) => (
            <li>
              <a
                href={withUtm(url, 'mobile_menu')}
                target="_blank"
                rel="noopener"
                class="inline-flex size-12 items-center justify-center bg-charcoal-2 text-ivory hover:text-gold"
                aria-label={`${socialLabels[key]} (opens in a new tab)`}
                data-follow={key}
                data-location="mobile_menu"
              >
                <PlatformIcon name={key} size={22} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</dialog>

<style>
  .site-header {
    transition:
      background-color 240ms ease,
      box-shadow 240ms ease;
  }
  .site-header[data-solid='true'] {
    background: var(--charcoal);
    box-shadow: 0 1px 0 var(--charcoal-2);
  }
  .site-header[data-solid='false'] {
    background: linear-gradient(to bottom, rgb(11 11 11 / 0.7), rgb(11 11 11 / 0));
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.65rem;
    color: var(--ivory);
    letter-spacing: var(--tracking-nav);
    transition: color 160ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.45rem;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 240ms var(--ease-out-soft);
  }
  .nav-link:hover {
    color: var(--gold);
  }
  .nav-link.is-active {
    color: var(--gold);
  }
  .nav-link.is-active::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--black);
    color: var(--ivory);
    overflow-y: auto;
  }
  .mobile-menu::backdrop {
    background: var(--black);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] .mobile-item {
      animation: menu-in 420ms var(--ease-out-soft) both;
      animation-delay: calc(var(--i) * 45ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  import { trapFocus } from '@/lib/focus-trap';
  const header = document.querySelector<HTMLElement>('[data-header]');
  const overlay = header?.dataset.solid === 'false';
  if (header && overlay) {
    const update = () => {
      header.dataset.solid = window.scrollY > 24 ? 'true' : 'false';
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (menu && openBtn) {
    trapFocus(menu);
    openBtn.addEventListener('click', () => {
      menu.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    closeBtn?.addEventListener('click', () => menu.close());
    // Esc is handled by <dialog>; restore state and focus on any close.
    menu.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    // Following an in-page link (e.g. /contact#booking) should close the menu.
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
    // Close if the viewport grows to desktop while open.
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
