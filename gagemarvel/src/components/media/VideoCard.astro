---
/**
 * Lite YouTube embed: shows the thumbnail first and loads the real player
 * (from youtube-nocookie.com) only after a click. Never autoplays with sound
 * on page load; the click itself starts playback.
 * Entries without a youtubeId render a "coming soon" poster.
 */
import Icon from '@/components/icons/Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  video: CollectionEntry<'videos'>;
  large?: boolean;
  headingLevel?: 2 | 3;
}
const { video, large = false, headingLevel = 3 } = Astro.props;
const { title, youtubeId, category, sample } = video.data;
const H = `h${headingLevel}` as 'h2' | 'h3';
const thumb = youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : '';
---

<figure class="video">
  <div class="frame">
    {youtubeId ? (
      <button
        type="button"
        class="poster"
        style={`background-image:url(${thumb})`}
        data-yt={youtubeId}
        data-yt-title={title}
      >
        <span class="play">
          <Icon name="play" size={large ? 30 : 22} />
        </span>
        <span class="sr-only">Play video: {title}</span>
      </button>
    ) : (
      <div class="poster empty">
        <span class="label text-ivory-muted">Video coming soon</span>
      </div>
    )}
  </div>
  <figcaption class="mt-3">
    <p class="label text-ivory-muted">
      {category === 'live' ? 'Live performance' : 'Music video'}
      {sample && ' · Sample'}
    </p>
    <H class:list={['mt-1', large ? 'text-display-sm' : 'text-2xl']}>{title}</H>
  </figcaption>
</figure>

<style>
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    background: var(--charcoal);
  }
  .poster {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-size: cover;
    background-position: center;
    cursor: pointer;
  }
  .poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.5), transparent 60%);
  }
  .empty {
    cursor: default;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(255 255 255 / 0.025) 14px 15px),
      var(--charcoal);
  }
  .play {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--black);
    padding-left: 4px;
    transition: transform 220ms var(--ease-out-soft);
  }
  .poster:hover .play {
    transform: scale(1.06);
  }
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  import { track } from '@/lib/analytics';
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
      f.title = btn.dataset.ytTitle ?? 'YouTube video';
      f.allow =
        'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      btn.replaceWith(f);
      f.focus();
      track('video_play', { videoTitle: btn.dataset.ytTitle ?? '' });
    });
  });
</script>
