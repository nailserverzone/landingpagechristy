---
/** Full-width gold JOIN THE FAN LIST band with halftone poster type behind it. */
import FanSignup from './FanSignup.astro';

interface Props {
  id: string;
  location: string;
  heading?: string;
  intro?: string;
}
const {
  id,
  location,
  heading = 'Join the Fan List',
  intro = 'New music and show announcements, straight from Gage. No spam, and you can leave anytime.',
} = Astro.props;
---

<section class="on-gold paper relative overflow-hidden" aria-labelledby={`${id}-heading`}>
  <div class="ht-wrap" aria-hidden="true">
    <p class="halftone halftone-rough ht-line">Fan</p>
    <p class="halftone halftone-rough ht-line ht-indent">List</p>
  </div>

  <div class="container-site relative grid gap-10 py-20 lg:grid-cols-12 lg:py-28">
    <div class="lg:col-span-5">
      <span class="gold-rule bg-black"></span>
      <h2 id={`${id}-heading`} class="text-display-lg mt-5">
        {heading}
      </h2>
      <p class="mt-5 max-w-md text-lg">{intro}</p>
    </div>
    <div class="lg:col-span-6 lg:col-start-7">
      <div class="card on-dark">
        <FanSignup id={id} location={location} />
      </div>
    </div>
  </div>
</section>

<style>
  .ht-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.16;
    --ht-dot: 9px;
  }
  .ht-line {
    font-size: clamp(9rem, 30vw, 30rem);
    white-space: nowrap;
    margin-left: -0.04em;
  }
  .ht-indent {
    margin-left: 18vw;
  }
  .card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 6px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
</style>
