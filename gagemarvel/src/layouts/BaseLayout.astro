---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ListenModal from '@/components/music/ListenModal.astro';
import NowSpinning from '@/components/music/NowSpinning.astro';
import { site } from '@/config/site';
import displayFont from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative share image (1200x630). */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** Image to preload (the hero), as returned by getImage(). */
  preloadImage?: { src: string; srcset?: string; sizes?: string };
  /** Transparent header over a full-bleed hero. */
  overlayHeader?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt = 'Gage Marvel',
  noindex = false,
  preloadImage,
  overlayHeader = false,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Official Site`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImage = new URL(image, site.url).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#0B0B0B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage.src}
        imagesrcset={preloadImage.srcset}
        imagesizes={preloadImage.sizes}
        fetchpriority="high"
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {ld.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('js-reveal');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="btn btn-gold sr-only-focusable fixed top-3 left-3 z-[100]">
      Skip to content
    </a>
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1" class:list={[!overlayHeader && 'pt-[var(--header-h)]']}>
      <slot />
    </main>
    <Footer />
    <ListenModal />
    <NowSpinning />

    <script>
      // Outbound click events (see README > Analytics event glossary).
      import { track } from '@/lib/analytics';
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLElement>(
          '[data-listen-platform],[data-follow],[data-ticket]',
        );
        if (!a) return;
        const d = a.dataset;
        if (d.listenPlatform)
          track('listen_click', {
            platform: d.listenPlatform,
            song: d.song ?? '',
            location: d.location ?? '',
          });
        else if (d.follow) track('follow_click', { network: d.follow, location: d.location ?? '' });
        else if (d.ticket) track('ticket_click', { venue: d.ticket, date: d.date ?? '' });
      });
    </script>
    <script>
      // Scroll reveal: fade/slide sections in once. Skipped entirely when the
      // visitor prefers reduced motion (the CSS never hides anything then).
      const root = document.documentElement;
      if (root.classList.contains('js-reveal') && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      } else {
        root.classList.remove('js-reveal');
      }
    </script>
  </body>
</html>
