---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Wordmark from '@/components/brand/Wordmark.astro';
import Icon from '@/components/icons/Icon.astro';
import VinylSleeve from '@/components/music/VinylSleeve.astro';
import PlatformButtons from '@/components/music/PlatformButtons.astro';
import PlayerEmbed from '@/components/music/PlayerEmbed.astro';
import ShareButton from '@/components/music/ShareButton.astro';
import RecordShelf from '@/components/music/RecordShelf.astro';
import VideoCard from '@/components/media/VideoCard.astro';
import ShowList from '@/components/shows/ShowList.astro';
import FanBand from '@/components/ui/FanBand.astro';
import FanSignup from '@/components/ui/FanSignup.astro';
import { getFeaturedSong, getShows, getVideos, getSongs } from '@/lib/content';
import { formatDate, kindLabel } from '@/lib/music';
import { showJsonLd } from '@/lib/shows';
import { site, social, bookingHref, activeLinks, withUtm } from '@/config/site';
import { musicGroupLd } from '@/lib/seo';

const featured = (await getFeaturedSong())!;
const allSongs = await getSongs();
const releaseCount = allSongs.length;
const firstYear = allSongs
  .map((s) => s.data.releaseDate?.slice(0, 4))
  .filter(Boolean)
  .sort()[0];
const { upcoming } = await getShows();
const nextShows = upcoming.slice(0, 3);
const videos = await getVideos();
const featuredVideo = videos.find((v) => v.data.featured) ?? videos[0];
const followUrl = activeLinks(social)[0]?.[1] ?? '';

// The hero glow is the featured cover, blurred. Small file: it is blurred anyway.
const glow = await getImage({ src: featured.data.cover, width: 480, format: 'webp' });
// TODO(content): when the professional hero photo arrives (16:9 + 4:5 crop),
// put it behind the wordmark here; the cover glow then becomes the fallback.
---

<BaseLayout
  overlayHeader
  preloadImage={{ src: glow.src }}
  jsonLd={[musicGroupLd(), ...upcoming.map(showJsonLd)]}
>
  <!-- 1. HERO -->
  <section class="hero grain relative isolate overflow-hidden" aria-labelledby="hero-title">
    <img src={glow.src} alt="" class="ambient" fetchpriority="high" />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-black/30 via-black/10 to-black"
      aria-hidden="true"
    ></div>

    <div class="container-site flex min-h-[100svh] flex-col justify-end pt-28 pb-10 lg:pb-14">
      <div class="hero-meta label flex justify-between gap-6" aria-hidden="true">
        <span>Country music</span>
        <span class="hidden sm:inline">{site.label}</span>
        <span>
          {releaseCount} releases since {firstYear}
        </span>
      </div>

      <h1 id="hero-title" class="mt-6">
        <span class="sr-only">Gage Marvel</span>
        <Wordmark title="" class="hero-mark" />
      </h1>

      <div class="mt-8 grid gap-8 border-t border-ivory/20 pt-6 md:grid-cols-12 md:items-end">
        <div class="md:col-span-5">
          <p class="text-lg text-ivory/85">{site.tagline}</p>
        </div>
        <a
          href="#featured"
          class="group flex items-center gap-4 md:col-span-4"
          aria-label={`Latest release: ${featured.data.title}`}
        >
          <Image
            src={featured.data.cover}
            alt=""
            width={64}
            height={64}
            format="webp"
            class="size-14 rounded-[3px] object-cover"
          />
          <span>
            <span class="label block text-gold">Latest release</span>
            <span class="font-display block text-2xl leading-none font-extrabold uppercase group-hover:underline">
              {featured.data.title}
            </span>
          </span>
        </a>
        <div class="flex flex-wrap gap-3 md:col-span-3 md:justify-end">
          <button type="button" class="btn btn-gold" data-listen-open>
            Listen Now
          </button>
          {followUrl && (
            <a
              href={withUtm(followUrl, 'hero')}
              target="_blank"
              rel="noopener"
              class="btn btn-outline"
              data-follow="instagram"
              data-location="hero"
            >
              Follow Gage<span class="sr-only"> (opens in a new tab)</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. FEATURED MUSIC -->
  <section
    id="featured"
    class="relative isolate overflow-hidden py-20 lg:py-32"
    aria-labelledby="featured-title"
    style={`--glow:${featured.data.glow ?? '#E8B830'}`}
  >
    <img src={glow.src} alt="" class="ambient opacity-35!" loading="lazy" />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-black via-black/60 to-black"
      aria-hidden="true"
    ></div>

    <div class="container-site grid items-center gap-12 lg:grid-cols-12" data-reveal>
      <div class="sleeve-host lg:col-span-6" tabindex="-1">
        <VinylSleeve
          song={featured}
          out
          sizes="(min-width: 1024px) 40vw, 80vw"
          class="mx-auto max-w-[34rem]"
        />
      </div>

      <div class="glass lg:col-span-6">
        <p class="label flex items-center gap-3 text-gold">
          <span class="eq" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          Featured {kindLabel(featured).toLowerCase()}
        </p>
        <h2 id="featured-title" class="text-display-md mt-3">
          {featured.data.title}
        </h2>
        <p class="mt-3 text-ivory-muted">
          {featured.data.releaseDate && <>Released {formatDate(featured.data.releaseDate)} · </>}
          {featured.data.label}
        </p>
        {featured.data.description && <p class="mt-4 text-lg">{featured.data.description}</p>}

        <PlayerEmbed song={featured} class="mt-8" />

        <p class="label mt-8 text-ivory-muted">Also on</p>
        <PlatformButtons song={featured} location="home_featured" class="mt-3" />
        <div class="mt-6 flex flex-wrap gap-3">
          <button type="button" class="btn btn-gold" data-listen-open>
            Listen Now
          </button>
          <ShareButton title={featured.data.title} path={`/music#${featured.id}`} />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RECORD SHELF -->
  <section class="py-16 lg:py-24" aria-labelledby="records-heading">
    <div class="container-site" data-reveal>
      <RecordShelf />
    </div>
  </section>

  <!-- 4. FEATURED VIDEO -->
  {featuredVideo && (
    <section class="py-16 lg:py-24" aria-labelledby="video-heading">
      <div class="container-site" data-reveal>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <span class="gold-rule" />
            <h2 id="video-heading" class="text-display-md mt-4">
              Watch
            </h2>
          </div>
          <a href="/media" class="label inline-flex min-h-11 items-center gap-2 hover:text-gold">
            All photos & videos <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <div class="mt-8">
          <VideoCard video={featuredVideo} large />
        </div>
      </div>
    </section>
  )}

  <!-- 5. NEXT SHOWS -->
  <section class="bg-charcoal py-16 lg:py-24" aria-labelledby="shows-heading">
    <div class="container-site" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="label text-ivory-muted">On the road</p>
          <h2 id="shows-heading" class="text-display-lg mt-3">
            Next Shows
          </h2>
        </div>
        {nextShows.length > 0 && (
          <a href="/shows" class="label inline-flex min-h-11 items-center gap-2 hover:text-gold">
            See all shows <Icon name="arrow-right" size={16} />
          </a>
        )}
      </div>
      {nextShows.length > 0 ? (
        <div class="mt-10">
          <ShowList shows={nextShows} />
        </div>
      ) : (
        <div class="mt-10 grid gap-8 border-t border-charcoal-2 pt-10 lg:grid-cols-2">
          <p class="font-display text-display-sm uppercase">
            Be the first to hear about new shows.
          </p>
          <FanSignup id="home-shows-signup" variant="compact" location="home_shows" />
        </div>
      )}
    </div>
  </section>

  <!-- 6. FAN LIST BAND -->
  <FanBand id="home-fan" location="home_band" />

  <!-- 7. BOOKING TEASER -->
  <section class="relative overflow-hidden py-20 lg:py-28" aria-labelledby="book-heading">
    <div class="container-site grid items-end gap-8 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-8">
        <p class="label text-ivory-muted">Venues · Festivals · Private events</p>
        <h2 id="book-heading" class="book-type mt-4">
          Book Gage
        </h2>
      </div>
      <div class="lg:col-span-4">
        <p class="text-lg text-ivory-muted">
          Planning a show, a festival bill or a private event? Send the details and the booking team
          will get back to you.
        </p>
        <a href={bookingHref} class="btn btn-gold mt-6">
          Book Gage
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-mark {
    width: min(100%, 64rem);
    height: auto;
  }
  .hero-meta {
    color: rgb(244 238 223 / 0.8);
  }
  .glass {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid rgb(244 238 223 / 0.12);
    border-radius: 14px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02));
    backdrop-filter: blur(18px);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.8);
  }
  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    background: currentColor;
    transform-origin: bottom;
  }
  .eq i:nth-child(2) {
    transform: scaleY(0.55);
  }
  .eq i:nth-child(3) {
    transform: scaleY(0.8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .eq i {
      animation: eq 1.1s ease-in-out infinite alternate;
    }
    .eq i:nth-child(2) {
      animation-delay: -0.4s;
    }
    .eq i:nth-child(3) {
      animation-delay: -0.75s;
    }
  }
  @keyframes eq {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }
  .book-type {
    font-size: clamp(4.5rem, 16vw, 15rem);
    line-height: 0.8;
    font-weight: 900;
    color: var(--gold);
  }
</style>
