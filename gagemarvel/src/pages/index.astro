---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/icons/Icon.astro';
import PortalHero from '@/components/home/PortalHero.astro';
import StatementFold from '@/components/home/StatementFold.astro';
import TitleMarquee from '@/components/home/TitleMarquee.astro';
import RecordDeck from '@/components/home/RecordDeck.astro';
import VideoCard from '@/components/media/VideoCard.astro';
import ShowList from '@/components/shows/ShowList.astro';
import FanBand from '@/components/ui/FanBand.astro';
import FanSignup from '@/components/ui/FanSignup.astro';
import { getShows, getVideos, getSongs } from '@/lib/content';
import { showJsonLd } from '@/lib/shows';
import { bookingHref } from '@/config/site';
import { musicGroupLd } from '@/lib/seo';

const { upcoming } = await getShows();
const nextShows = upcoming.slice(0, 3);
const videos = await getVideos();
const featuredVideo = videos.find((v) => v.data.featured) ?? videos[0];
const songs = await getSongs();
---

<BaseLayout overlayHeader jsonLd={[musicGroupLd(), ...upcoming.map(showJsonLd)]}>
  <!-- 1. Portal hero (h1 lives here) -->
  <PortalHero />

  <!-- 2. Statement + featured single -->
  <StatementFold />

  <TitleMarquee />

  <!-- 3. The records: a throwable deck -->
  <section class="overflow-x-clip py-20 lg:py-32" aria-labelledby="records-heading">
    <div class="container-site grid items-center gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="label text-ivory-muted">Discography · {songs.length} releases</p>
        <h2 id="records-heading" class="text-display-lg mt-4">
          The Records
        </h2>
        <p class="mt-6 max-w-md text-lg text-ivory-muted">
          Every single and EP, newest on top. Throw a card aside to flip to the next, press play for
          a 30 second preview, or open the full catalogue.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/music" class="btn btn-gold">
            All Music
          </a>
          <button type="button" class="btn btn-outline" data-listen-open>
            Listen Now
          </button>
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <RecordDeck />
      </div>
    </div>
  </section>

  <!-- 4. Featured video -->
  {featuredVideo && (
    <section class="pb-20 lg:pb-28" aria-labelledby="video-heading">
      <div class="container-site" data-reveal>
        <div class="flex flex-wrap items-end justify-between gap-4 border-t border-charcoal-2 pt-10">
          <h2 id="video-heading" class="text-display-md">
            Watch
          </h2>
          <a href="/media" class="label inline-flex min-h-11 items-center gap-2 hover:text-gold">
            All photos & videos <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <div class="mt-8">
          <VideoCard video={featuredVideo} large />
        </div>
      </div>
    </section>
  )}

  <!-- 5. Dates -->
  <section class="bg-charcoal py-20 lg:py-28" aria-labelledby="shows-heading">
    <div class="container-site" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="label text-ivory-muted">On the road</p>
          <h2 id="shows-heading" class="text-display-lg mt-3">
            Dates
          </h2>
        </div>
        {nextShows.length > 0 && (
          <a href="/shows" class="label inline-flex min-h-11 items-center gap-2 hover:text-gold">
            See all shows <Icon name="arrow-right" size={16} />
          </a>
        )}
      </div>
      {nextShows.length > 0 ? (
        <div class="mt-10">
          <ShowList shows={nextShows} />
        </div>
      ) : (
        <div class="mt-10 grid gap-8 border-t border-charcoal-2 pt-10 lg:grid-cols-2">
          <p class="font-display text-display-sm uppercase">
            Be the first to hear about new shows.
          </p>
          <FanSignup id="home-shows-signup" variant="compact" location="home_shows" />
        </div>
      )}
    </div>
  </section>

  <!-- 6. Fan list -->
  <FanBand id="home-fan" location="home_band" />

  <!-- 7. Close -->
  <section class="py-20 lg:py-28" aria-labelledby="close-heading">
    <div class="container-site flex flex-wrap items-end justify-between gap-10" data-reveal>
      <div>
        <p class="label text-ivory-muted">Venues · Festivals · Private events</p>
        <h2 id="close-heading" class="close-h mt-4">
          Book Gage
        </h2>
        <p class="mt-4 max-w-md text-ivory-muted">
          Tell us the date, the place and the crowd, and the booking team will take it from there.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={bookingHref} class="btn btn-gold">
          Book Gage
        </a>
        <a href="/contact" class="btn btn-outline">
          Contact
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .close-h {
    font-size: clamp(4rem, 13vw, 11rem);
    line-height: 0.8;
    font-weight: 900;
  }
</style>
